# ══════════════════════════════════════════════════════════════
# .env.production — Template para despliegue en producción
# ══════════════════════════════════════════════════════════════
# INSTRUCCIONES:
#   1. Copiar este archivo como .env en el servidor de producción
#   2. Completar TODAS las variables marcadas con <COMPLETAR>
#   3. Nunca commitear el .env final — solo este template
# ══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<COMPLETAR_CON_SECRET_DE_64_CHARS>

# ── Admin Inicial ─────────────────────────────────────────────
ADMIN_EMAIL=<COMPLETAR_EMAIL_ADMIN>
ADMIN_PASSWORD=<COMPLETAR_PASSWORD_SEGURO>

# ── Supabase (BD PostgreSQL) ─────────────────────────────────
SUPABASE_URL=<COMPLETAR>
SUPABASE_ANON_KEY=<COMPLETAR>
SUPABASE_SERVICE_ROLE_KEY=<COMPLETAR>

DB_HOST=<proyecto>.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.<ref_proyecto>
DB_PASSWORD=<COMPLETAR>
DB_NAME=postgres
DB_SSL=true

# Connection String (para herramientas externas / migraciones DDL)
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<ref_proyecto>.supabase.co:5432/postgres

# ── Encryption Key (para passwords SMTP almacenados) ─────────
ENCRYPTION_KEY=<COMPLETAR_CON_HEX_DE_64_CHARS>

# ── SMTP Notificador (para alertas del sistema) ──────────────
SMTP_NOTIFIER_HOST=smtp.gmail.com
SMTP_NOTIFIER_PORT=465
SMTP_NOTIFIER_USER=<COMPLETAR>
SMTP_NOTIFIER_PASS=<COMPLETAR_APP_PASSWORD>

# ── Telegram (alertas de errores) ────────────────────────────
TELEGRAM_CHAT_ID=<COMPLETAR>
TELEGRAM_TOKEN=<COMPLETAR>

# ── CORS ──────────────────────────────────────────────────────
# En producción, Nginx hace reverse proxy, así que el frontend
# y la API comparten el mismo origin. Si se accede por IP:
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ── Backups ───────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7

# ── Google Drive OAuth2 (subida automática de backups) ────────
GDRIVE_ENABLED=true
GDRIVE_CLIENT_ID=<COMPLETAR>
GDRIVE_CLIENT_SECRET=<COMPLETAR>
GDRIVE_REFRESH_TOKEN=<COMPLETAR>
GDRIVE_FOLDER_ID=<COMPLETAR>