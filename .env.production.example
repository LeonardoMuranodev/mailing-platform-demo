# ==============================================================================
# .env.production.example - Template para despliegue en producción
# ==============================================================================
# INSTRUCCIONES:
#   1. Copiar este archivo como .env en el servidor de producción
#   2. Completar TODAS las variables marcadas con <COMPLETAR>
#   3. Nunca commitear el .env final — solo este template
# ==============================================================================

# --- Server & URLs ---
PORT=3000
NODE_ENV=production
APP_URL=https://tu-dominio.com
PUBLIC_API_URL=https://api.tu-dominio.com

# --- JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<COMPLETAR_CON_SECRET_DE_64_CHARS>
JWT_EXPIRES_IN=24h

# --- Admin Inicial ---
ADMIN_EMAIL=<COMPLETAR_EMAIL_ADMIN>
ADMIN_PASSWORD=<COMPLETAR_PASSWORD_SEGURO>

# --- Base de Datos PostgreSQL / Supabase ---
DB_HOST=<proyecto>.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.<ref_proyecto>
DB_PASSWORD=<COMPLETAR>
DB_NAME=postgres
DB_SSL=true

# Connection String para migraciones externas
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<ref_proyecto>.supabase.co:5432/postgres

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Encryption Key (Cifrado AES-256 de credenciales en base de datos) ---
ENCRYPTION_KEY=<COMPLETAR_CON_HEX_DE_64_CHARS>

# --- SMTP Notificador (Para alertas del sistema y mails transaccionales) ---
SMTP_NOTIFIER_HOST=smtp.gmail.com
SMTP_NOTIFIER_PORT=465
SMTP_NOTIFIER_USER=<COMPLETAR>
SMTP_NOTIFIER_PASS=<COMPLETAR_APP_PASSWORD>
SENDER_NAME=GenMailer Notificaciones
SUPPORT_SENDER_NAME=GenMailer Soporte

# --- Destinatarios Configurables de Alertas y Pruebas ---
TEST_EMAIL_RECIPIENT=qa-pruebas@tu-dominio.com
ALERT_EMAIL_DESTINATION=operaciones@tu-dominio.com

# --- Telegram (Alertas críticas al equipo de guardia) ---
TELEGRAM_CHAT_ID=<COMPLETAR>
TELEGRAM_TOKEN=<COMPLETAR>

# --- Gmail API OAuth 2.0 (Despacho Balanceado de Campañas) ---
GMAIL_OAUTH_CLIENT_ID=<COMPLETAR_CLIENT_ID>
GMAIL_OAUTH_CLIENT_SECRET=<COMPLETAR_CLIENT_SECRET>
USER_SMTP1=<COMPLETAR_CUENTA_1>
REFRESH_TOKEN_SMTP1=<COMPLETAR_REFRESH_TOKEN_1>
USER_SMTP2=<COMPLETAR_CUENTA_2>
REFRESH_TOKEN_SMTP2=<COMPLETAR_REFRESH_TOKEN_2>

# --- Resend API & Webhooks (Telemetría de Rebotes / Clicks / Opens) ---
RESEND_API_KEY=<COMPLETAR_RESEND_API_KEY>
RESEND_WEBHOOK_SECRET=<COMPLETAR_SVIX_WEBHOOK_SECRET>

# --- CORS ---
ALLOWED_ORIGINS=https://tu-dominio.com,https://api.tu-dominio.com

# --- Backups Automáticos ---
BACKUP_RETENTION_DAYS=7
GDRIVE_ENABLED=false
GDRIVE_CLIENT_ID=<COMPLETAR>
GDRIVE_CLIENT_SECRET=<COMPLETAR>
GDRIVE_REFRESH_TOKEN=<COMPLETAR>
GDRIVE_FOLDER_ID=<COMPLETAR>

# --- Adjuntos Campañas ---
MAX_ADJUNTOS=6
VITE_MAX_ADJUNTOS=6
