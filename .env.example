# ==============================================================================
# .env.example - Configuración de Desarrollo Local (Docker Compose)
# ==============================================================================
# Copiar este archivo como .env para levantar todo el stack con:
# docker compose up --build
# ==============================================================================

# --- Entorno & Servidor ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# --- Modo Prueba ---
# true: no envía mails reales hacia clientes y relaja validaciones
MODO_PRUEBA=false

# --- Base de Datos PostgreSQL (Servicio 'db' en docker-compose) ---
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=genmailer
DB_SSL=false

# --- Redis (Cola de Envío y Caché) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Seguridad & JWT ---
JWT_SECRET=super_secret_jwt_key_para_desarrollo_local_min_32_chars!
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Usuario Administrador Inicial (Seed) ---
ADMIN_EMAIL=admin@genmailer.com
ADMIN_PASSWORD=Admin1234!

# --- Notificador SMTP (Para correos de alertas, transaccionales y prueba) ---
SMTP_NOTIFIER_HOST=smtp.gmail.com
SMTP_NOTIFIER_PORT=465
SMTP_NOTIFIER_USER=alertas@tuorganizacion.com
SMTP_NOTIFIER_PASS=tu_app_password
SENDER_NAME=GenMailer Notificaciones
SUPPORT_SENDER_NAME=GenMailer Soporte

# --- Destinatarios Configurables de Alertas y Pruebas ---
# Si se definen, el mail de prueba y los avisos de campaña finalizada/cuota irán a estas casillas:
TEST_EMAIL_RECIPIENT=dev-test@tuorganizacion.com
ALERT_EMAIL_DESTINATION=operaciones@tuorganizacion.com

# --- Telegram Bot (Alertas críticas opcionales) ---
TELEGRAM_CHAT_ID=
TELEGRAM_TOKEN=

# --- Gmail API OAuth 2.0 (Envío Seguro Multi-Cuenta) ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
USER_SMTP1=
REFRESH_TOKEN_SMTP1=
USER_SMTP2=
REFRESH_TOKEN_SMTP2=

# --- Resend API & Webhooks (Telemetría de Rebotes / Clicks / Opens) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Límites de Adjuntos ---
MAX_ADJUNTOS=6
VITE_MAX_ADJUNTOS=6
